#!/usr/bin/env bash
set -euo pipefail

{{ if eq .machineType "macos" -}}
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

brew bundle --file=- <<'EOF'
brew "git"
cask "alacritty"
cask "font-hack-nerd-font"
EOF
{{ else -}}
exit 0
{{ end -}}
